# Server & Security
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-a-64-char-random-secret
SESSION_SECRET=replace-with-a-64-char-random-secret
QR_SIGNING_SECRET=replace-with-a-64-char-random-secret
QR_KEY_ID=k1
QR_PREVIOUS_KEY_ID=
QR_PREVIOUS_SIGNING_SECRET=
QR_TOKEN_TTL_SECONDS=31536000
DEFAULT_CURRENCY=USD

# Database (Replica Set required for transactions)
MONGODB_URI=mongodb://localhost:27017/reboxify?replicaSet=rs0

# PayPal Developer Sandbox (Secrets never sent to frontend)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Google Gemini API (Backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_MAX_PER_MIN=20

# Elasticsearch (Derived search index)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=reboxify
ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000

# Worker Intervals & Reliability (ms)
ENABLE_EMBEDDED_WORKER=false
OUTBOX_POLL_INTERVAL_MS=5000
RECONCILE_INTERVAL_MS=60000
PENDING_RECONCILE_MIN_AGE_MS=120000
WORKER_LEASE_TTL_MS=90000
WORKER_MAX_BACKOFF_MS=300000
WEBHOOK_MAX_RETRIES=5

